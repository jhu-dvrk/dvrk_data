#!/usr/bin/env python3

import argparse
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

PREFIX = "@dvrk:"
ROLE_STEREO_SOURCE = "stereo_source"
ROLE_STEREO_ALIGNMENT = "stereo_alignment"


def make_socket(role, name):
    return f"{PREFIX}{role}:{name}"


def find_executable(package, name):
    here = Path(sys.argv[0]).resolve().parent
    candidate = here / name
    if candidate.exists():
        return [str(candidate)]

    for parent in Path(sys.argv[0]).resolve().parents:
        candidate = parent / package / "lib" / package / name
        if candidate.exists():
            return [str(candidate)]

    return ["ros2", "run", package, name]


def find_sibling_executable(name):
    return find_executable("dvrk_data", name)


def run_process(label, cmd, log_dir):
    log_path = log_dir / f"{label}.log"
    ros_log_dir = log_dir / "ros"
    ros_log_dir.mkdir(exist_ok=True)
    env = os.environ.copy()
    env.setdefault("ROS_LOG_DIR", str(ros_log_dir))
    log = log_path.open("w")
    proc = subprocess.Popen(
        cmd,
        stdout=log,
        stderr=subprocess.STDOUT,
        env=env,
        start_new_session=True,
        text=True,
    )
    return {"label": label, "cmd": cmd, "log_path": log_path, "log": log, "proc": proc}


def stop_process(entry, timeout=5.0):
    proc = entry["proc"]
    if proc.poll() is not None:
        entry["log"].close()
        return
    try:
        os.killpg(proc.pid, signal.SIGINT)
        proc.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, signal.SIGTERM)
        try:
            proc.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            os.killpg(proc.pid, signal.SIGKILL)
            proc.wait()
    finally:
        entry["log"].close()


def require_alive(entry):
    proc = entry["proc"]
    if proc.poll() is None:
        return
    raise RuntimeError(
        f"{entry['label']} exited early with code {proc.returncode}. "
        f"See {entry['log_path']}"
    )


def wait_for_path(path, timeout, label, entry=None):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if entry is not None:
            require_alive(entry)
        if Path(path).exists():
            return
        time.sleep(0.1)
    raise TimeoutError(f"Timed out waiting for {label}: {path}")


def wait_for_socket(abstract_name, timeout, label, entry=None):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if entry is not None:
            require_alive(entry)
        try:
            with open("/proc/net/unix") as stream:
                if any(abstract_name in line for line in stream):
                    return
        except OSError:
            pass
        time.sleep(0.1)
    raise TimeoutError(f"Timed out waiting for {label}: {abstract_name}")


def ros2_topic_pub(topic, msg_type, value):
    subprocess.run(
        ["ros2", "topic", "pub", "--once", topic, msg_type, value],
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def write_json(path, data):
    path.write_text(json.dumps(data, indent=2) + "\n")


def build_source_config(path, sockets):
    write_json(
        path,
        {
            "type": "dvrk_data:stereo_source@1.0.0",
            "name": "dvrk_smoke",
            "camera": {
                "size": {"width": 640, "height": 480},
                "left": {
                    "gst_input": (
                        "videotestsrc pattern=smpte is-live=true "
                        "! video/x-raw,width=640,height=480,framerate=30/1"
                    )
                },
                "right": {
                    "gst_input": (
                        "videotestsrc pattern=ball is-live=true "
                        "! video/x-raw,width=640,height=480,framerate=30/1"
                    )
                },
            },
        },
    )


def build_alignment_config(path, sockets):
    write_json(
        path,
        {
            "type": "dvrk_data:stereo_alignment@1.0.0",
            "name": "dvrk_smoke",
            "gst_output": sockets["stereo"],
            "camera": {
                "size": {"width": 640, "height": 480},
                "crop": {"width": 640, "height": 480},
                "alignment": {"horizontal_shift_px": 0, "vertical_shift_px": 0},
                "left": {"gst_input": sockets["left"]},
                "right": {"gst_input": sockets["right"]},
            },
        },
    )


def build_stereo_config(path, sockets, display_enabled):
    sinks = ["glimage"] if display_enabled else []
    write_json(
        path,
        {
            "type": "dvrk_console:stereo_display@1.0.0",
            "name": "dvrk_smoke",
            "dvrk_console_namespace": "console",
            "sinks": sinks,
            "gst_input": sockets["stereo"],
            "eye_size": {"width": 640, "height": 480},
        },
    )


def build_record_config(path, output_dir, sockets):
    write_json(
        path,
        {
            "type": "dvrk_data:record@1.0.0",
            "data_directory": str(output_dir),
            "videos": [
                {
                    "name": "dvrk_smoke_stereo",
                    "gst_input": sockets["stereo"],
                    "record": True,
                    "timestamp_overlay": False,
                    "side_by_side": "LR",
                    "encoding": {
                        "frame_rate": 30,
                        "bitrate_kbps": 10000,
                    },
                }
            ],
            "ros_topics": [
                {"name": "/dvrk_test/correlation", "continuous": False},
            ],
        },
    )


def explicit_annotation_timestamp_ns(frame):
    realtime = frame.get("cpu", {}).get("realtime", {})
    if not isinstance(realtime, dict):
        return None
    mono = realtime.get("mono_source_ns")
    if isinstance(mono, int) and mono >= 0:
        return mono
    left = realtime.get("left_source_ns")
    right = realtime.get("right_source_ns")
    has_left = isinstance(left, int) and left >= 0
    has_right = isinstance(right, int) and right >= 0
    if has_left and has_right:
        return left // 2 + right // 2 + ((left % 2) + (right % 2)) // 2
    if has_left:
        return left
    if has_right:
        return right
    recorder = realtime.get("recorder_reception_ns")
    if isinstance(recorder, int) and recorder >= 0:
        return recorder
    return None


def validate_sidecar(path):
    data = json.loads(path.read_text())
    frames = data.get("frames", [])
    if not frames:
        raise RuntimeError(f"{path} has no frames")
    if data.get("frames_recorded") != len(frames):
        raise RuntimeError(f"{path} frames_recorded={data.get('frames_recorded')} but frames={len(frames)}")
    stats = data.get("timestamp_statistics", {})
    if stats.get("from_unixfd", 0) + stats.get("at_reception", 0) != len(frames):
        raise RuntimeError(f"{path} timestamp_statistics does not sum to frame count")

    annotation_ts = []
    gst_pts = []
    for i, frame in enumerate(frames):
        if "derived" in frame:
            raise RuntimeError(f"{path} frame {i} still contains removed derived timestamps")
        ts = explicit_annotation_timestamp_ns(frame)
        if ts is None:
            raise RuntimeError(f"{path} frame {i} lacks explicit annotation timestamp")
        annotation_ts.append(ts)
        pts = frame.get("gst", {}).get("pts_ns")
        if not isinstance(pts, int) or pts < 0:
            raise RuntimeError(f"{path} frame {i} lacks valid gst.pts_ns")
        gst_pts.append(pts)

    if any(b < a for a, b in zip(annotation_ts, annotation_ts[1:])):
        raise RuntimeError(f"{path} explicit annotation timestamps are not monotonic")
    if any(b < a for a, b in zip(gst_pts, gst_pts[1:])):
        raise RuntimeError(f"{path} gst.pts_ns values are not monotonic")


def count_bag_messages(bag_path, topic_name):
    import rosbag2_py

    storage_id = "mcap" if list(Path(bag_path).glob("*.mcap")) else "sqlite3"
    reader = rosbag2_py.SequentialReader()
    reader.open(
        rosbag2_py.StorageOptions(uri=str(bag_path), storage_id=storage_id),
        rosbag2_py.ConverterOptions("", ""),
    )
    topics = {topic.name for topic in reader.get_all_topics_and_types()}
    if topic_name not in topics:
        raise RuntimeError(f"Bag {bag_path} does not contain topic {topic_name}; found {sorted(topics)}")
    count = 0
    while reader.has_next():
        topic, _, _ = reader.read_next()
        if topic == topic_name:
            count += 1
    return count


def run_extract(session_dir, log_dir):
    extract_dir = session_dir / "extracted"
    cmd = find_sibling_executable("extract") + [
        "-d", str(session_dir),
        "-a",
        "-f", "mp4",
        "-f", "png",
        "-S",
    ]
    log_path = log_dir / "extract.log"
    with log_path.open("w") as log:
        subprocess.run(cmd, check=True, stdout=log, stderr=subprocess.STDOUT)
    full_session = extract_dir / "full_session"
    if not full_session.exists():
        raise RuntimeError(f"extract did not create {full_session}")
    if not list(full_session.glob("*.mp4")):
        raise RuntimeError(f"extract did not produce MP4 output in {full_session}")
    if not list(full_session.glob("*.png")):
        raise RuntimeError(f"extract did not produce PNG output in {full_session}")
    if not list(full_session.glob("*.csv")):
        raise RuntimeError(f"extract did not produce ROS CSV output in {full_session}")


def check_recording_output(output_dir, log_dir, run_extract_check):
    mp4s = list(output_dir.rglob("*.mp4"))
    sidecars = []
    for path in output_dir.rglob("*.json"):
        try:
            data = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if data.get("type") == "dvrk_data:video_sidecar@1.0.0":
            sidecars.append(path)
    rosbags = [p for p in output_dir.rglob("*") if p.is_dir() and p.name == "rosbag"]
    if not mp4s:
        raise RuntimeError(f"No MP4 recording found under {output_dir}")
    if not sidecars:
        raise RuntimeError(f"No sidecar JSON found under {output_dir}")
    if not rosbags:
        raise RuntimeError(f"No rosbag directory found under {output_dir}")
    for sidecar in sidecars:
        validate_sidecar(sidecar)
    bag_messages = count_bag_messages(rosbags[0], "/dvrk_test/correlation")
    if bag_messages <= 0:
        raise RuntimeError(f"No /dvrk_test/correlation messages recorded in {rosbags[0]}")
    if run_extract_check:
        session_dir = sidecars[0].parent
        run_extract(session_dir, log_dir)
    return mp4s, sidecars, rosbags, bag_messages


def main():
    parser = argparse.ArgumentParser(description="Run a unixfd-only dVRK data/console smoke test")
    parser.add_argument("--duration", type=float, default=10.0)
    parser.add_argument("--startup-timeout", type=float, default=10.0)
    parser.add_argument("--output-dir", default="")
    parser.add_argument("--keep-output", action="store_true")
    parser.add_argument("--no-display", action="store_true")
    parser.add_argument("--with-record", action="store_true")
    parser.add_argument("--skip-extract", action="store_true")
    args = parser.parse_args()

    if (not args.no_display or args.with_record) and not os.environ.get("DISPLAY"):
        raise RuntimeError("smoke_test_stack requires DISPLAY because stereo_display creates a GTK control window")

    root = Path(args.output_dir) if args.output_dir else Path(tempfile.mkdtemp(prefix="dvrk_smoke_"))
    root.mkdir(parents=True, exist_ok=True)
    log_dir = root / "logs"
    record_dir = root / "recordings"
    log_dir.mkdir(exist_ok=True)
    record_dir.mkdir(exist_ok=True)

    sockets = {
        "left": make_socket(ROLE_STEREO_SOURCE, "left"),
        "right": make_socket(ROLE_STEREO_SOURCE, "right"),
        "stereo": make_socket(ROLE_STEREO_ALIGNMENT, "stereo"),
    }

    source_config = root / "stereo_source.json"
    alignment_config = root / "stereo_alignment.json"
    stereo_config = root / "stereo_display.json"
    record_config = root / "record.json"
    build_source_config(source_config, sockets)
    build_alignment_config(alignment_config, sockets)
    build_stereo_config(stereo_config, sockets, not args.no_display)
    build_record_config(record_config, record_dir, sockets)

    processes = []
    try:
        source_cmd = find_sibling_executable("stereo_source") + ["-c", str(source_config)]
        processes.append(run_process("stereo_source", source_cmd, log_dir))
        wait_for_socket(sockets["left"], args.startup_timeout, "left source socket", processes[-1])
        wait_for_socket(sockets["right"], args.startup_timeout, "right source socket", processes[-1])

        alignment_cmd = find_sibling_executable("stereo_alignment") + ["-c", str(alignment_config)]
        processes.append(run_process("stereo_alignment", alignment_cmd, log_dir))
        wait_for_socket(sockets["stereo"], args.startup_timeout, "stereo output socket", processes[-1])

        if not args.no_display:
            stereo_cmd = find_executable("dvrk_console", "stereo_display") + ["-c", str(stereo_config)]
            processes.append(run_process("stereo_display", stereo_cmd, log_dir))

        if args.with_record:
            record_cmd = find_sibling_executable("record") + ["-c", str(record_config)]
            processes.append(run_process("record", record_cmd, log_dir))
            time.sleep(2.0)
            require_alive(processes[-1])
            ros2_topic_pub("/record/record", "std_msgs/msg/Bool", "{data: true}")
            topic_pub = run_process(
                "correlation_topic",
                ["ros2", "topic", "pub", "-r", "10", "/dvrk_test/correlation",
                 "std_msgs/msg/String", "{data: smoke}"],
                log_dir,
            )
            processes.append(topic_pub)

        deadline = time.monotonic() + args.duration
        while time.monotonic() < deadline:
            for entry in processes:
                require_alive(entry)
            time.sleep(0.25)

        if args.with_record:
            ros2_topic_pub("/record/record", "std_msgs/msg/Bool", "{data: false}")
            time.sleep(0.5)
            ros2_topic_pub("/record/record", "std_msgs/msg/Bool", "{data: true}")
            time.sleep(1.0)
            ros2_topic_pub("/record/record", "std_msgs/msg/Bool", "{data: false}")
            time.sleep(1.0)

    finally:
        for entry in reversed(processes):
            stop_process(entry)

    if args.with_record:
        mp4s, sidecars, rosbags, bag_messages = check_recording_output(
            record_dir, log_dir, not args.skip_extract)
        print(f"Recorded MP4 files: {len(mp4s)}")
        print(f"Sidecar files: {len(sidecars)}")
        print(f"Rosbag directories: {len(rosbags)}")
        print(f"ROS bag /dvrk_test/correlation messages: {bag_messages}")

    print(f"Smoke test passed. Logs: {log_dir}")
    if not args.keep_output and not args.output_dir:
        shutil.rmtree(root, ignore_errors=True)


if __name__ == "__main__":
    main()
