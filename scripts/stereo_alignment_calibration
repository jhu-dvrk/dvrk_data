#!/usr/bin/env python3

import argparse
import copy
import json
import threading
import time
from pathlib import Path

import cv2
import numpy as np
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import GdkPixbuf, GLib, Gtk
from dvrk_data import dvrk_gst_socket as dvrk_gst

def clip_int(value: int, min_value: int, max_value: int) -> int:
    return max(min_value, min(max_value, value))

def clip_float(value: float, min_value: float, max_value: float) -> float:
    return max(min_value, min(max_value, value))

def compute_stats(yuv, mask):
    pixels = yuv[mask].astype(np.float32)
    luma = pixels[:, 0]
    chroma = pixels[:, 1:] - 128.0
    return {
        "mean_y": float(np.mean(luma)),
        "std_y": float(np.std(luma)),
        "chroma_rms": float(np.sqrt(np.mean(np.sum(chroma * chroma, axis=1)))),
    }


def calculate_match_from_stats(source, target, luma_only=False):
    # A nearly flat image does not contain enough information to fit contrast.
    contrast = (clip_float(target["std_y"] / source["std_y"], 0.7, 1.3)
                if source["std_y"] >= 8.0 and target["std_y"] >= 8.0 else 1.0)
    # GStreamer videobalance applies contrast around video black (Y=16).
    brightness = (target["mean_y"] - 16.0
                  - (source["mean_y"] - 16.0) * contrast) / 255.0
    brightness = clip_float(brightness, -0.25, 0.25)
    saturation = 1.0
    if not luma_only and min(source["chroma_rms"], target["chroma_rms"]) >= 8.0:
        saturation = clip_float(target["chroma_rms"] / source["chroma_rms"], 0.7, 1.3)
    return {"brightness": brightness, "contrast": contrast,
            "saturation": saturation, "hue": 0.0}


def calculate_calibration(mode, left_bgr, right_bgr):
    neutral = dict(NEUTRAL_COLOR)
    if mode == "none":
        return neutral, neutral
    left_yuv = cv2.cvtColor(left_bgr, cv2.COLOR_BGR2YUV)
    right_yuv = cv2.cvtColor(right_bgr, cv2.COLOR_BGR2YUV)
    # Compare corresponding visible pixels, excluding black borders and clipped highlights.
    mask = ((left_yuv[:, :, 0] >= 24) & (left_yuv[:, :, 0] <= 235)
            & (right_yuv[:, :, 0] >= 24) & (right_yuv[:, :, 0] <= 235))
    if np.count_nonzero(mask) < max(100, mask.size // 100):
        return None
    left_stats = compute_stats(left_yuv, mask)
    right_stats = compute_stats(right_yuv, mask)
    if mode == "left_ref":
        return neutral, calculate_match_from_stats(right_stats, left_stats)
    if mode == "right_ref":
        return calculate_match_from_stats(left_stats, right_stats), neutral
    if mode in ("average", "average_luma"):
        average = {key: (left_stats[key] + right_stats[key]) / 2.0 for key in left_stats}
        luma_only = mode == "average_luma"
        return (calculate_match_from_stats(left_stats, average, luma_only),
                calculate_match_from_stats(right_stats, average, luma_only))
    raise ValueError(f"Unknown color matching mode: {mode}")


def apply_color_calibration_preview(bgr, color_params):
    brightness = color_params.get("brightness", 0.0)
    contrast = color_params.get("contrast", 1.0)
    saturation = color_params.get("saturation", 1.0)
    hue = color_params.get("hue", 0.0)
    if brightness == 0.0 and contrast == 1.0 and saturation == 1.0 and hue == 0.0:
        return bgr

    # Approximate GStreamer videobalance in YUV rather than HSV.
    yuv = cv2.cvtColor(bgr, cv2.COLOR_BGR2YUV).astype(np.float32)
    yuv[:, :, 0] = np.clip(16 + (yuv[:, :, 0] - 16) * contrast
                           + brightness * 255.0, 0, 255)
    u = yuv[:, :, 1] - 128.0
    v = yuv[:, :, 2] - 128.0
    angle = np.pi * hue
    yuv[:, :, 1] = np.clip(128 + saturation * (u * np.cos(angle) + v * np.sin(angle)), 0, 255)
    yuv[:, :, 2] = np.clip(128 + saturation * (-u * np.sin(angle) + v * np.cos(angle)), 0, 255)
    return cv2.cvtColor(yuv.astype(np.uint8), cv2.COLOR_YUV2BGR)


def offset_valid_range(working_size: int, crop_size: int):
    crop_total = max(0, working_size - crop_size)
    center = crop_total // 2

    min_half = -center
    max_half = crop_total - center

    min_offset = int(np.ceil(2.0 * min_half)) + 1
    max_offset = int(np.floor(2.0 * max_half)) - 1

    if min_offset > max_offset:
        return 0, 0
    return min_offset, max_offset


def clamp_offset_to_valid(working_size: int, crop_size: int, offset_px: int) -> int:
    minimum, maximum = offset_valid_range(working_size, crop_size)
    return clip_int(offset_px, minimum, maximum)


def maximal_crop_for_shift(working_size: int, offset_px: int) -> int:
    """Largest crop for which both eye crops support the requested shift."""
    if offset_px == 0:
        return working_size
    for crop_size in range(working_size - 1, 0, -1):
        minimum, maximum = offset_valid_range(working_size, crop_size)
        if minimum <= offset_px <= maximum:
            return crop_size
    return 1


def compute_axis_starts(crop_total: int, offset_px: int):
    center = crop_total // 2
    negative_start = center - int(np.floor(offset_px / 2.0))
    positive_start = center + int(np.ceil(offset_px / 2.0))
    return negative_start, positive_start


def compute_eye_crop(working_w: int, working_h: int, crop_w: int, crop_h: int, horizontal_shift: int, vertical_shift: int, sign: int):
    crop_x_total = max(0, working_w - crop_w)
    crop_y_total = max(0, working_h - crop_h)

    left_start, right_start = compute_axis_starts(crop_x_total, horizontal_shift)
    top_start, bottom_start = compute_axis_starts(crop_y_total, vertical_shift)

    left_crop = left_start if sign < 0 else right_start
    right_crop = crop_x_total - left_crop
    top_crop = top_start if sign < 0 else bottom_start
    bottom_crop = crop_y_total - top_crop
    return left_crop, right_crop, top_crop, bottom_crop


def crop_frame(frame, crop):
    left_crop, right_crop, top_crop, bottom_crop = crop
    height, width = frame.shape[:2]
    return frame[top_crop:height - bottom_crop, left_crop:width - right_crop]


def as_preview_pipeline(source_snippet: str) -> str:
    snippet = source_snippet.strip()
    if "appsink" in snippet:
        return snippet
    return f"{snippet} ! videoconvert ! appsink drop=true sync=false"


def open_capture(source_label: str, source_snippet: str, timeout=10.0):
    pipeline = as_preview_pipeline(source_snippet)
    deadline = time.monotonic() + timeout
    while True:
        cap = cv2.VideoCapture(pipeline, cv2.CAP_GSTREAMER)
        if cap.isOpened():
            return cap
        cap.release()
        if time.monotonic() >= deadline:
            break
        time.sleep(0.25)
    msg = (f"Unable to open {source_label} source with GStreamer backend.\n"
           f"Pipeline: {pipeline}\n")
    if "unixfdsrc" in pipeline:
        import re
        match = re.search(r"socket-path=(\S+)", pipeline)
        socket_path = ("@" + match.group(1)) if match else "<socket>"
        msg += (
            f"\nThe abstract socket {socket_path} could not be opened.\n"
            "Start source and calibration together from the configuration directory:\n"
            "  ros2 launch dvrk_data stereo_alignment_calibration.launch.py\n"
            "\nTo list currently active @dvrk sockets:\n"
            "  ros2 run dvrk_data gscam_socket"
        )
    raise RuntimeError(msg)


def ensure_config_fields(config):
    # Keep the original type if it exists, otherwise use standard dvrk_data:stereo_alignment@1.0.0
    config.setdefault("type", "dvrk_data:stereo_alignment@1.0.0")
    config.setdefault("name", "stereo_alignment")
    config.setdefault("preserve_size", True)
    cam = config.setdefault("camera", {})
    cam.setdefault("size", "auto")
    lft = cam.setdefault("left", {})
    lft.setdefault("color", {"brightness": 0.0, "contrast": 1.0, "saturation": 1.0, "hue": 0.0})
    rgt = cam.setdefault("right", {})
    rgt.setdefault("color", {"brightness": 0.0, "contrast": 1.0, "saturation": 1.0, "hue": 0.0})
    return config


def load_or_create(path: Path):
    if path.exists():
        with path.open("r", encoding="utf-8") as stream:
            return json.load(stream)

    return {
        "type": "dvrk_data:stereo_alignment@1.0.0",
        "name": "stereo_alignment",
        "preserve_size": True,
        "camera": {
            "size": "auto",
            "left": {"color": {"brightness": 0.0, "contrast": 1.0, "saturation": 1.0, "hue": 0.0}},
            "right": {"color": {"brightness": 0.0, "contrast": 1.0, "saturation": 1.0, "hue": 0.0}},
        },
    }


def parse_args():
    parser = argparse.ArgumentParser(
        description=(
            "Interactive dvrk_data stereo alignment calibration tool. "
            "Loads or creates a JSON file, previews stereo composition, and saves crop/shift values in pixels."
        )
    )
    parser.add_argument("-c", "--config", required=True, help="Path to dvrk_data stereo_alignment JSON config")
    return parser.parse_args()


def update_config_from_runtime(config, stereo_input, original_w, original_h,
                               crop_w, crop_h, horizontal_shift, vertical_shift,
                               left_color, right_color):
    config.setdefault("type", "dvrk_data:stereo_alignment@1.0.0")
    config.setdefault("name", "stereo_alignment")
    config.setdefault("preserve_size", True)
    if stereo_input != "@dvrk:stereo_source:stereo":
        config["gst_input"] = stereo_input
    else:
        config.pop("gst_input", None)

    cam = config.setdefault("camera", {})
    cam["size"] = (
        "auto" if "@dvrk:" in stereo_input or "unixfdsrc" in stereo_input
        else {"width": int(original_w), "height": int(original_h)}
    )
    cam.setdefault("left", {}).pop("gst_input", None)
    cam.setdefault("right", {}).pop("gst_input", None)
    cam["left"]["color"] = left_color
    cam["right"]["color"] = right_color
    cam["crop"] = {"width": int(crop_w), "height": int(crop_h)}
    cam["alignment"] = {
        "horizontal_shift_px": int(horizontal_shift),
        "vertical_shift_px": int(vertical_shift),
    }


NEUTRAL_COLOR = {"brightness": 0.0, "contrast": 1.0, "saturation": 1.0, "hue": 0.0}
COLOR_MODES = {
    "Left reference": "left_ref",
    "Right reference": "right_ref",
    "Average": "average",
    "Average (luminance only)": "average_luma",
}


class FrameReader:
    """Keep socket reads off the UI thread and retain only the newest frame."""

    def __init__(self, capture, first_frame):
        self.capture = capture
        self.frame = first_frame
        self.lock = threading.Lock()
        self.stop_event = threading.Event()
        self.thread = threading.Thread(target=self._read, daemon=True)
        self.thread.start()

    def _read(self):
        while not self.stop_event.is_set():
            ok, frame = self.capture.read()
            if ok and frame is not None:
                with self.lock:
                    self.frame = frame
            else:
                self.stop_event.wait(0.05)

    def latest(self):
        with self.lock:
            return self.frame

    def stop(self):
        self.stop_event.set()
        self.thread.join(timeout=0.5)
        if not self.thread.is_alive():
            self.capture.release()


class VideoWindow(Gtk.Window):
    """A movable preview window that can be hidden and restored."""

    def __init__(self, title, width=720, height=550):
        super().__init__(title=title)
        self.set_default_size(width, height)
        self.image = Gtk.Image()
        self.add(self.image)
        self.connect("delete-event", self._hide_on_close)

    def _hide_on_close(self, _window, _event):
        self.hide()
        return True

    def set_frame(self, bgr):
        rgb = cv2.cvtColor(bgr, cv2.COLOR_BGR2RGB)
        height, width = rgb.shape[:2]
        data = GLib.Bytes.new(rgb.tobytes())
        pixbuf = GdkPixbuf.Pixbuf.new_from_bytes(
            data, GdkPixbuf.Colorspace.RGB, False, 8, width, height, width * 3)
        allocated = self.image.get_allocation()
        default_width, default_height = self.get_default_size()
        available_width = allocated.width if allocated.width > 1 else default_width - 16
        available_height = allocated.height if allocated.height > 1 else default_height - 70
        scale = min(available_width / width, available_height / height)
        pixbuf = pixbuf.scale_simple(max(1, round(width * scale)),
                                     max(1, round(height * scale)),
                                     GdkPixbuf.InterpType.BILINEAR)
        self.image.set_from_pixbuf(pixbuf)


def compose_difference_overlay(left, right, difference_gain, brightness):
    """Show shared detail in gray and unmatched eyes in complementary colors."""
    left_gray = cv2.cvtColor(left, cv2.COLOR_BGR2GRAY).astype(np.float32)
    right_gray = cv2.cvtColor(right, cv2.COLOR_BGR2GRAY).astype(np.float32)
    shared = np.minimum(left_gray, right_gray) * 0.5
    left_only = np.maximum(left_gray - right_gray, 0) * difference_gain
    right_only = np.maximum(right_gray - left_gray, 0) * difference_gain
    green = np.clip((shared + left_only) * brightness, 0, 255).astype(np.uint8)
    magenta = np.clip((shared + right_only) * brightness, 0, 255).astype(np.uint8)
    return cv2.merge((magenta, green, magenta))


class OverlayWindow(VideoWindow):
    def __init__(self):
        Gtk.Window.__init__(self, title="Stereo alignment overlay")
        self.set_default_size(720, 550)
        self.connect("delete-event", self._hide_on_close)
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.add(content)
        self.image = Gtk.Image()
        content.pack_start(self.image, True, True, 0)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row.set_border_width(8)
        row.pack_start(Gtk.Label(label="Brightness"), False, False, 0)
        self.brightness = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 200, 5)
        self.brightness.set_value(100)
        self.brightness.set_digits(0)
        self.brightness.set_hexpand(True)
        row.pack_start(self.brightness, True, True, 0)
        content.pack_start(row, False, False, 0)
        difference_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        difference_row.set_border_width(8)
        difference_row.pack_start(Gtk.Label(label="Difference gain"), False, False, 0)
        self.difference_gain = Gtk.Scale.new_with_range(
            Gtk.Orientation.HORIZONTAL, 1, 12, 0.5)
        self.difference_gain.set_value(5)
        self.difference_gain.set_digits(1)
        self.difference_gain.set_hexpand(True)
        difference_row.pack_start(self.difference_gain, True, True, 0)
        content.pack_start(difference_row, False, False, 0)


class CalibrationWindow(Gtk.Window):
    def __init__(self, config, path, stereo_input, capture, first_frame):
        super().__init__(title="dVRK stereo alignment calibration")
        self.set_default_size(840, 850)
        self.connect("delete-event", self._on_close)
        self.config = config
        self.path = path
        self.stereo_input = stereo_input
        self.reader = FrameReader(capture, first_frame)
        self.eye_width = first_frame.shape[1] // 2
        self.eye_height = first_frame.shape[0]
        cam = config["camera"]
        size = cam.get("size", "auto")
        if size == "auto":
            size = {}
        self.original_width = min(int(size.get("width", self.eye_width)), self.eye_width)
        self.original_height = min(int(size.get("height", self.eye_height)), self.eye_height)
        crop = cam.get("crop", {})
        crop_width = clip_int(int(crop.get("width", self.original_width)), 1, self.original_width)
        crop_height = clip_int(int(crop.get("height", self.original_height)), 1, self.original_height)
        alignment = cam.get("alignment", {})
        self.last_frame = first_frame
        self.stereo_window = VideoWindow("Stereo preview (left | right)", 1100, 620)
        self.left_window = VideoWindow("Left preview")
        self.right_window = VideoWindow("Right preview")
        self.overlay_window = OverlayWindow()
        self._setup_ui(crop_width, crop_height, alignment, cam)
        self.saved_config = copy.deepcopy(config)
        self._closing = False
        self.timer_id = GLib.timeout_add(100, self.refresh_preview)
        self.refresh_preview()

    @staticmethod
    def _section(title):
        frame = Gtk.Frame(label=title)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_border_width(10)
        frame.add(box)
        return frame, box

    @staticmethod
    def _spin(minimum, maximum, value, digits=0):
        spin = Gtk.SpinButton.new_with_range(minimum, maximum, 0.01 if digits else 1)
        spin.set_digits(digits)
        spin.set_value(value)
        spin.set_width_chars(12 if digits else 7)
        return spin

    @staticmethod
    def _row(box, label, widget):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        caption = Gtk.Label(label=label, xalign=0)
        caption.set_hexpand(True)
        row.pack_start(caption, True, True, 0)
        row.pack_end(widget, False, False, 0)
        box.pack_start(row, False, False, 0)

    def _setup_ui(self, crop_width, crop_height, alignment, cam):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        root.set_border_width(10)
        self.add(root)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        root.pack_start(scroll, True, True, 0)
        settings = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        settings.set_border_width(4)
        scroll.add(settings)
        geometry_column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        color_column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        settings.pack_start(geometry_column, True, True, 0)
        settings.pack_start(color_column, True, True, 0)

        frame, box = self._section("Video windows")
        self.side_by_side = Gtk.CheckButton(label="Side-by-side stereo preview")
        self.side_by_side.set_active(True)
        self.side_by_side.connect("toggled", self._show_video_windows)
        box.pack_start(self.side_by_side, False, False, 0)
        show = Gtk.Button(label="Show video windows")
        show.connect("clicked", self._show_video_windows)
        box.pack_start(show, False, False, 0)
        geometry_column.pack_start(frame, False, False, 0)

        frame, box = self._section("Source")
        for text in (f"Stereo input: {self.stereo_input}",
                     f"Detected per eye: {self.eye_width} × {self.eye_height}",
                     f"Working size: {self.original_width} × {self.original_height}",
                     f"Configuration: {self.path}"):
            label = Gtk.Label(label=text, xalign=0)
            label.set_line_wrap(True)
            label.set_max_width_chars(45)
            box.pack_start(label, False, False, 0)
        geometry_column.pack_start(frame, False, False, 0)

        frame, box = self._section("Crop")
        self.crop_check = Gtk.CheckButton(label="Apply crop")
        self.crop_check.set_active(True)
        self.crop_check.connect("toggled", self._crop_changed)
        box.pack_start(self.crop_check, False, False, 0)
        self.auto_crop = Gtk.CheckButton(label="Auto-crop for current alignment")
        self.auto_crop.set_active(True)
        self.auto_crop.connect("toggled", self._crop_changed)
        box.pack_start(self.auto_crop, False, False, 0)
        self.crop_width = self._spin(1, self.original_width, crop_width)
        self.crop_height = self._spin(1, self.original_height, crop_height)
        self._row(box, "Width (px)", self.crop_width)
        self._row(box, "Height (px)", self.crop_height)
        geometry_column.pack_start(frame, False, False, 0)

        frame, box = self._section("Alignment")
        self.alignment_check = Gtk.CheckButton(label="Apply alignment")
        horizontal = int(alignment.get("horizontal_shift_px", 0))
        vertical = int(alignment.get("vertical_shift_px", 0))
        self.alignment_check.set_active(horizontal != 0 or vertical != 0)
        self.alignment_check.connect("toggled", self._alignment_changed)
        box.pack_start(self.alignment_check, False, False, 0)
        hmin, hmax = offset_valid_range(self.original_width, 1)
        vmin, vmax = offset_valid_range(self.original_height, 1)
        self.horizontal = self._spin(hmin, hmax, clip_int(horizontal, hmin, hmax))
        self.vertical = self._spin(vmin, vmax, clip_int(vertical, vmin, vmax))
        self._row(box, "Horizontal shift (px)", self.horizontal)
        self._row(box, "Vertical shift (px)", self.vertical)
        reset = Gtk.Button(label="Reset alignment")
        reset.connect("clicked", self.reset_alignment)
        box.pack_start(reset, False, False, 0)
        geometry_column.pack_start(frame, False, False, 0)

        frame, box = self._section("Automatic color match")
        self.color_mode = Gtk.ComboBoxText()
        for name in COLOR_MODES:
            self.color_mode.append_text(name)
        self.color_mode.set_active(3)
        self._row(box, "Method", self.color_mode)
        match = Gtk.Button(label="Calculate from current frame")
        match.connect("clicked", self.calculate_color_match)
        box.pack_start(match, False, False, 0)
        reset_color = Gtk.Button(label="Reset color adjustments")
        reset_color.connect("clicked", self.reset_color)
        box.pack_start(reset_color, False, False, 0)
        color_column.pack_start(frame, False, False, 0)

        self.color_checks = {}
        self.color_controls = {}
        for eye in ("left", "right"):
            frame, box = self._section(f"{eye.capitalize()} color")
            check = Gtk.CheckButton(label="Apply color correction")
            values = cam.get(eye, {}).get("color", {})
            check.set_active(any(float(values.get(key, neutral)) != neutral
                                 for key, neutral in NEUTRAL_COLOR.items()))
            box.pack_start(check, False, False, 0)
            controls = {}
            for key, neutral in NEUTRAL_COLOR.items():
                minimum = 0 if key in ("contrast", "saturation") else -1
                maximum = 2 if key in ("contrast", "saturation") else 1
                spin = self._spin(minimum, maximum, float(values.get(key, neutral)), 9)
                self._row(box, key.capitalize(), spin)
                controls[key] = spin
            check.connect("toggled", self._color_changed, eye)
            self.color_checks[eye] = check
            self.color_controls[eye] = controls
            color_column.pack_start(frame, False, False, 0)
        self._crop_changed()
        self._alignment_changed()
        for eye in ("left", "right"):
            self._color_changed(None, eye)

        self.status = Gtk.Label(xalign=0)
        self.status.set_line_wrap(True)
        root.pack_start(self.status, False, False, 0)
        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        for label, callback in (("Save", self.save),
                                ("Save & quit", self.save_and_quit),
                                ("Quit", self._quit_clicked)):
            button = Gtk.Button(label=label)
            button.set_size_request(-1, 42)
            button.connect("clicked", callback)
            actions.pack_start(button, True, True, 0)
        root.pack_start(actions, False, False, 0)

    def _crop_changed(self, _button=None):
        enabled = self.crop_check.get_active()
        self.auto_crop.set_sensitive(enabled)
        manual = enabled and not self.auto_crop.get_active()
        self.crop_width.set_sensitive(manual)
        self.crop_height.set_sensitive(manual)

    def _alignment_changed(self, _button=None):
        enabled = self.alignment_check.get_active()
        self.horizontal.set_sensitive(enabled)
        self.vertical.set_sensitive(enabled)
        if enabled and not self.crop_check.get_active():
            self.crop_check.set_active(True)
            self.auto_crop.set_active(True)

    def _color_changed(self, _button, eye):
        enabled = self.color_checks[eye].get_active()
        for control in self.color_controls[eye].values():
            control.set_sensitive(enabled)

    def _show_video_windows(self, _button=None):
        if self.side_by_side.get_active():
            self.left_window.hide()
            self.right_window.hide()
            self.stereo_window.show_all()
        else:
            self.stereo_window.hide()
            self.left_window.show_all()
            self.right_window.show_all()
        self.overlay_window.show_all()

    def show_previews(self):
        self.stereo_window.move(500, 40)
        self.left_window.move(500, 40)
        self.right_window.move(540, 80)
        self.overlay_window.move(580, 120)
        self._show_video_windows()

    def reset_alignment(self, _button=None):
        self.horizontal.set_value(0)
        self.vertical.set_value(0)
        self.alignment_check.set_active(False)

    def effective_settings(self):
        horizontal = self.horizontal.get_value_as_int() if self.alignment_check.get_active() else 0
        vertical = self.vertical.get_value_as_int() if self.alignment_check.get_active() else 0
        if self.crop_check.get_active():
            if self.auto_crop.get_active():
                width = maximal_crop_for_shift(self.original_width, horizontal)
                height = maximal_crop_for_shift(self.original_height, vertical)
                if self.crop_width.get_value_as_int() != width:
                    self.crop_width.set_value(width)
                if self.crop_height.get_value_as_int() != height:
                    self.crop_height.set_value(height)
            else:
                width = self.crop_width.get_value_as_int()
                height = self.crop_height.get_value_as_int()
        else:
            width, height = self.original_width, self.original_height
        horizontal = clamp_offset_to_valid(self.original_width, width, horizontal)
        vertical = clamp_offset_to_valid(self.original_height, height, vertical)
        colors = {}
        for eye in ("left", "right"):
            colors[eye] = ({key: spin.get_value() for key, spin in self.color_controls[eye].items()}
                           if self.color_checks[eye].get_active() else dict(NEUTRAL_COLOR))
        return width, height, horizontal, vertical, colors

    def _cropped_eyes(self, frame, width, height, horizontal, vertical):
        left = frame[:self.original_height, :self.original_width]
        right = frame[:self.original_height, self.eye_width:self.eye_width + self.original_width]
        left = crop_frame(left, compute_eye_crop(self.original_width, self.original_height,
                                                width, height, horizontal, vertical, -1))
        right = crop_frame(right, compute_eye_crop(self.original_width, self.original_height,
                                                  width, height, horizontal, vertical, 1))
        return left, right

    def refresh_preview(self):
        frame = self.reader.latest()
        if frame is None or frame.shape[1] != 2 * self.eye_width or frame.shape[0] < self.original_height:
            return True
        self.last_frame = frame
        width, height, horizontal, vertical, colors = self.effective_settings()
        left, right = self._cropped_eyes(frame, width, height, horizontal, vertical)
        if left.size == 0 or right.size == 0:
            return True
        preview_width = min(width, 800)
        target = (preview_width, max(1, round(height * preview_width / width)))
        left = cv2.resize(left, target, interpolation=cv2.INTER_AREA)
        right = cv2.resize(right, target, interpolation=cv2.INTER_AREA)
        left = apply_color_calibration_preview(left, colors["left"])
        right = apply_color_calibration_preview(right, colors["right"])
        if self.side_by_side.get_active():
            self.stereo_window.set_frame(np.hstack((left, right)))
        else:
            self.left_window.set_frame(left)
            self.right_window.set_frame(right)
        overlay = compose_difference_overlay(
            left, right,
            self.overlay_window.difference_gain.get_value(),
            self.overlay_window.brightness.get_value() / 100.0)
        self.overlay_window.set_frame(overlay)
        self.status.set_text(f"Output per eye: {width} × {height} px. "
                             f"Shift: horizontal {horizontal:+d}, vertical {vertical:+d} px.")
        return True

    def reset_color(self, _button=None):
        for eye in ("left", "right"):
            for key, spin in self.color_controls[eye].items():
                spin.set_value(NEUTRAL_COLOR[key])
            self.color_checks[eye].set_active(False)
        self.refresh_preview()

    def calculate_color_match(self, _button=None):
        width, height, horizontal, vertical, _ = self.effective_settings()
        left, right = self._cropped_eyes(self.last_frame, width, height, horizontal, vertical)
        if left.size == 0 or right.size == 0:
            return
        mode = COLOR_MODES[self.color_mode.get_active_text()]
        values = calculate_calibration(mode, left, right)
        if values is None:
            self.status.set_text("Not enough visible, unclipped pixels to calculate a color match.")
            return
        for eye, color in zip(("left", "right"), values):
            for key, spin in self.color_controls[eye].items():
                spin.set_value(color[key])
            self.color_checks[eye].set_active(any(abs(color[key] - neutral) > 0.0005
                                                  for key, neutral in NEUTRAL_COLOR.items()))
        self.refresh_preview()

    def configured_values(self):
        width, height, horizontal, vertical, colors = self.effective_settings()
        config = copy.deepcopy(self.config)
        update_config_from_runtime(config, self.stereo_input,
                                   self.original_width, self.original_height,
                                   width, height, horizontal, vertical,
                                   colors["left"], colors["right"])
        return config

    def save(self, _button=None):
        config = self.configured_values()
        try:
            self.path.parent.mkdir(parents=True, exist_ok=True)
            self.path.write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
        except OSError as exc:
            dialog = Gtk.MessageDialog(
                transient_for=self, modal=True, message_type=Gtk.MessageType.ERROR,
                buttons=Gtk.ButtonsType.CLOSE, text=f"Could not save calibration: {exc}")
            dialog.run()
            dialog.destroy()
            return False
        self.config = config
        self.saved_config = copy.deepcopy(config)
        self.status.set_text(f"Saved {self.path}")
        return True

    def save_and_quit(self, _button=None):
        if self.save():
            self._closing = True
            self.close()

    def _quit_clicked(self, _button):
        self.close()

    def _on_close(self, _window, _event):
        if not self._closing and self.configured_values() != self.saved_config:
            dialog = Gtk.MessageDialog(
                transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                buttons=Gtk.ButtonsType.NONE, text="Save changes before quitting?")
            dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                               "Discard", Gtk.ResponseType.NO,
                               "Save", Gtk.ResponseType.YES)
            answer = dialog.run()
            dialog.destroy()
            if answer == Gtk.ResponseType.CANCEL or answer == Gtk.ResponseType.DELETE_EVENT:
                return True
            if answer == Gtk.ResponseType.YES and not self.save():
                return True
        GLib.source_remove(self.timer_id)
        self.reader.stop()
        for window in (self.stereo_window, self.left_window,
                       self.right_window, self.overlay_window):
            window.destroy()
        Gtk.main_quit()
        return False


def main():
    args = parse_args()
    path = Path(args.config)
    config = load_or_create(path)
    ensure_config_fields(config)
    cam_size = config["camera"].get("size", "auto")
    if cam_size == "auto":
        cam_size = {}
    stereo_input = config.get("gst_input", "@dvrk:stereo_source:stereo").strip()
    if not stereo_input:
        print("Error: gst_input must be a nonempty stereo socket or GStreamer source")
        return 1
    pipeline = dvrk_gst.build_input(stereo_input, dvrk_gst.ROLE_STEREO_SOURCE,
                                    2 * int(cam_size.get("width", 0)),
                                    int(cam_size.get("height", 0)))
    try:
        capture = open_capture("stereo", pipeline)
        ok, first_frame = capture.read()
        if not ok or first_frame is None:
            raise RuntimeError("Unable to read the first frame from the stereo source")
        if first_frame.shape[1] < 2 or first_frame.shape[1] % 2:
            raise RuntimeError("Stereo source width must be positive and even")
    except RuntimeError as exc:
        if "capture" in locals():
            capture.release()
        print(f"Error: {exc}")
        return 1
    window = CalibrationWindow(config, path, stereo_input, capture, first_frame)
    window.show_all()
    window.show_previews()
    Gtk.main()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
