"""Find and save shared stereo color correction independently of geometry."""
import argparse
import copy
from pathlib import Path

import cv2
import numpy as np
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk
from dvrk_data import dvrk_gst_socket as sockets
from dvrk_data.stereo_preview import FrameReader, VideoWindow, open_capture
from dvrk_data.stereo_color_adjustment import (
    COLOR_MODES, NEUTRAL_COLOR, apply_color_calibration_preview,
    calculate_calibration, load_color_file, save_color_file,
)


class ColorWindow(Gtk.Window):
    def __init__(self, path, config, input_name, capture, frame):
        super().__init__(title="dVRK stereo color adjustment")
        self.set_default_size(600, 520)
        self.path = path
        self.saved = config
        self.last_frame = frame
        self.reader = FrameReader(capture, frame)
        self.preview = VideoWindow("Stereo color preview (left | right)", 1100, 620)
        self.preview.show_all()
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        root.set_border_width(12)
        self.add(root)
        label = Gtk.Label(label=f"Input: {input_name}\nColor configuration: {path}", xalign=0)
        label.set_line_wrap(True)
        root.pack_start(label, False, False, 0)
        self.mode = Gtk.ComboBoxText()
        for name in COLOR_MODES:
            self.mode.append_text(name)
        self.mode.set_active(3)
        root.pack_start(self.mode, False, False, 0)
        match = Gtk.Button(label="Calculate from current frame")
        match.connect("clicked", self.calculate)
        root.pack_start(match, False, False, 0)
        self.original = Gtk.CheckButton(label="Preview original colors")
        root.pack_start(self.original, False, False, 0)
        columns = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        root.pack_start(columns, True, True, 0)
        self.controls = {}
        for eye in ("left", "right"):
            frame_box = Gtk.Frame(label=eye.capitalize())
            column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            column.set_border_width(8)
            frame_box.add(column)
            columns.pack_start(frame_box, True, True, 0)
            self.controls[eye] = {}
            for key, neutral in NEUTRAL_COLOR.items():
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                row.pack_start(Gtk.Label(label=key.capitalize(), xalign=0), True, True, 0)
                low, high = (0, 2) if key in ("contrast", "saturation") else (-1, 1)
                spin = Gtk.SpinButton.new_with_range(low, high, 0.01)
                spin.set_digits(9)
                spin.set_value(config[eye].get(key, neutral))
                row.pack_end(spin, False, False, 0)
                column.pack_start(row, False, False, 0)
                self.controls[eye][key] = spin
        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        for label, handler in (("Reset", self.reset), ("Save", self.save), ("Save & quit", self.save_and_quit)):
            button = Gtk.Button(label=label)
            button.connect("clicked", handler)
            actions.pack_start(button, True, True, 0)
        root.pack_start(actions, False, False, 0)
        self.status = Gtk.Label(xalign=0)
        self.status.set_line_wrap(True)
        root.pack_start(self.status, False, False, 0)
        self.saved_values = self.values()
        self.connect("delete-event", self.close_window)
        self.timer = GLib.timeout_add(100, self.refresh)
        self.refresh()

    def values(self):
        return {eye: {key: spin.get_value() for key, spin in controls.items()}
                for eye, controls in self.controls.items()}

    def refresh(self):
        frame = self.reader.latest()
        if frame is None or frame.shape[1] % 2:
            return True
        self.last_frame = frame
        width = frame.shape[1] // 2
        size = (min(width, 800), max(1, round(frame.shape[0] * min(width, 800) / width)))
        eyes = [cv2.resize(frame[:, :width], size), cv2.resize(frame[:, width:], size)]
        colors = self.values()
        if not self.original.get_active():
            eyes = [apply_color_calibration_preview(image, colors[eye])
                    for eye, image in zip(("left", "right"), eyes)]
        self.preview.set_frame(np.hstack(eyes))
        return True

    def calculate(self, _button):
        width = self.last_frame.shape[1] // 2
        result = calculate_calibration(COLOR_MODES[self.mode.get_active_text()],
                                       self.last_frame[:, :width], self.last_frame[:, width:])
        if result is None:
            self.status.set_text("Not enough visible, unclipped pixels to calculate a color match.")
            return
        for eye, parameters in zip(("left", "right"), result):
            for key, value in parameters.items():
                self.controls[eye][key].set_value(value)
        self.status.set_text("Calculated color adjustments. Review the preview, then save.")
        self.refresh()

    def reset(self, _button):
        for controls in self.controls.values():
            for key, spin in controls.items():
                spin.set_value(NEUTRAL_COLOR[key])
        self.refresh()

    def save(self, _button=None):
        values = self.values()
        try:
            save_color_file(self.path, values["left"], values["right"])
        except (OSError, ValueError) as error:
            self.status.set_text(f"Could not save color adjustment: {error}")
            return False
        self.saved_values = copy.deepcopy(values)
        self.status.set_text(f"Saved {self.path}")
        return True

    def save_and_quit(self, _button):
        if self.save():
            self.close()

    def close_window(self, _window, _event):
        if self.values() != self.saved_values:
            dialog = Gtk.MessageDialog(transient_for=self, modal=True,
                message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                text="Save color adjustments before quitting?")
            dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                               "Discard", Gtk.ResponseType.NO, "Save", Gtk.ResponseType.YES)
            answer = dialog.run()
            dialog.destroy()
            if answer in (Gtk.ResponseType.CANCEL, Gtk.ResponseType.DELETE_EVENT):
                return True
            if answer == Gtk.ResponseType.YES and not self.save():
                return True
        GLib.source_remove(self.timer)
        self.reader.stop()
        self.preview.destroy()
        Gtk.main_quit()
        return False


def main():
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
    parser.add_argument("-i", "--input", default="@dvrk:stereo_source:stereo",
                        help="Side-by-side stereo socket or GStreamer pipeline")
    parser.add_argument("-c", "--config", default="stereo_color_adjustment.json",
                        help="Shared color JSON to load/save (default: stereo_color_adjustment.json)")
    args = parser.parse_args()
    path = Path(args.config)
    try:
        config = load_color_file(path)
        capture = open_capture("side-by-side stereo", sockets.build_input(args.input))
        ok, frame = capture.read()
        if not ok or frame is None or frame.shape[1] < 2 or frame.shape[1] % 2:
            capture.release()
            raise RuntimeError("Input must be a valid side-by-side stereo stream")
    except (OSError, ValueError, RuntimeError) as error:
        print(f"Error: {error}")
        return 1
    window = ColorWindow(path, config, args.input, capture, frame)
    window.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
