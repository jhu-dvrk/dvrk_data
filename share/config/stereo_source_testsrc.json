{
  "type": "dvrk_data:stereo_source@1.0.0",
  "name": "dvrk_test",
  "camera": {
    "size": {
      "width": 640,
      "height": 480
    },
    "left": {
      "gst_input": "videotestsrc pattern=smpte is-live=true ! video/x-raw,width=640,height=480,framerate=30/1",
      "gst_output": "@dvrk:stereo_source:left"
    },
    "right": {
      "gst_input": "videotestsrc pattern=ball is-live=true ! video/x-raw,width=640,height=480,framerate=30/1",
      "gst_output": "@dvrk:stereo_source:right"
    }
  }
}
