{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dvrk_data:stereo_alignment@1.0.0",
  "title": "dVRK stereo alignment configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "camera"],
  "properties": {
    "type": { "const": "dvrk_data:stereo_alignment@1.0.0" },
    "name": { "type": "string", "minLength": 1, "default": "dvrk_display" },
    "gst_output": { "$ref": "#/$defs/gstOutput" },
    "preserve_size": { "type": "boolean", "default": true },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "left", "right", "crop"],
      "properties": {
        "size": { "$ref": "#/$defs/size" },
        "left": { "$ref": "#/$defs/cameraEndpoint" },
        "right": { "$ref": "#/$defs/cameraEndpoint" },
        "crop": { "$ref": "#/$defs/size" },
        "alignment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "horizontal_shift_px": { "type": "integer", "default": 0 },
            "vertical_shift_px": { "type": "integer", "default": 0 }
          }
        }
      }
    }
  },
  "$defs": {
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brightness": { "type": "number", "default": 0.0 },
        "contrast": { "type": "number", "default": 1.0 },
        "saturation": { "type": "number", "default": 1.0 },
        "hue": { "type": "number", "default": 0.0 }
      }
    },
    "cameraEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gst_input"],
      "properties": {
        "gst_input": { "$ref": "#/$defs/gstInput" },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "gstInput": {
      "type": "string",
      "minLength": 1,
      "description": "Plain GStreamer pipeline or canonical @dvrk:role:name socket reference."
    },
    "gstOutput": {
      "type": "string",
      "anyOf": [
        { "const": "" },
        { "pattern": "^@dvrk:[^:]+:[^:]+$" }
      ],
      "description": "Canonical dVRK abstract socket reference."
    }
  }
}
