{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dvrk_data:stereo_alignment@1.0.0",
  "title": "dVRK stereo alignment configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "camera"
  ],
  "properties": {
    "type": {
      "const": "dvrk_data:stereo_alignment@1.0.0"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "default": "dvrk_display"
    },
    "gst_output": {
      "$ref": "#/$defs/gstOutput"
    },
    "preserve_size": {
      "type": "boolean",
      "default": true
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "crop"
      ],
      "properties": {
        "size": {
          "description": "Use 'auto' to detect incoming camera caps, or specify a fixed size for pixel-based crop and shift calibration.",
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "$ref": "#/$defs/size"
            }
          ]
        },
        "crop": {
          "$ref": "#/$defs/size"
        },
        "alignment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "horizontal_shift_px": {
              "type": "integer",
              "default": 0,
              "description": "Per-camera horizontal crop alignment in input pixels; positive increases crossed disparity. This does not change physical camera baseline."
            },
            "vertical_shift_px": {
              "type": "integer",
              "default": 0,
              "description": "Per-camera vertical crop alignment in input pixels."
            }
          }
        }
      }
    },
    "gst_input": {
      "$ref": "#/$defs/gstInput",
      "description": "Combined left-right stereo input; defaults to @dvrk:stereo_source:stereo."
    }
  },
  "$defs": {
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "gstInput": {
      "type": "string",
      "minLength": 1,
      "description": "Plain GStreamer pipeline or canonical @dvrk:role:name socket reference."
    },
    "gstOutput": {
      "type": "string",
      "anyOf": [
        {
          "const": ""
        },
        {
          "pattern": "^@dvrk:[^:]+:[^:]+$"
        }
      ],
      "description": "Canonical dVRK abstract socket reference."
    }
  }
}
