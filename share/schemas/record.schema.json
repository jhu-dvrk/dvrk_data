{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dvrk_data:record@1.0.0",
  "title": "dVRK data recording configuration",
  "description": "Configuration consumed by the dvrk_data record and video_latency executables.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type"],
  "properties": {
    "type": { "const": "dvrk_data:record@1.0.0" },
    "configuration_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Additional record configurations loaded recursively before this file."
    },
    "data_directory": {
      "type": "string",
      "minLength": 1,
      "default": "."
    },
    "record_audio": {
      "type": "boolean",
      "default": false
    },
    "ros_topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "continuous": {
            "type": "boolean",
            "default": false,
            "description": "Record after the first acquisition begins, including intervals when video recording is stopped."
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "videos": {
      "type": "array",
      "items": { "$ref": "#/$defs/video" }
    }
  },
  "$defs": {
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "gst_input"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "gst_input": {
          "type": "string",
          "minLength": 1,
          "description": "GStreamer source pipeline or canonical @dvrk socket reference."
        },
        "record": { "type": "boolean", "default": true },
        "timestamp_overlay": { "type": "boolean", "default": false },
        "side_by_side": {
          "enum": ["LR", "RL"],
          "description": "Eye order in a side-by-side stereo stream."
        },
        "estimated_latency": {
          "type": "number",
          "minimum": 0,
          "default": 0.0,
          "description": "Capture-to-observation latency in seconds, maintained by video_latency."
        },
        "encoding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "frame_rate": { "type": "integer", "minimum": 1 },
            "bitrate_kbps": { "type": "integer", "minimum": 1, "default": 10000 },
            "speed_preset": { "type": "integer", "minimum": 1, "maximum": 10, "default": 5 },
            "key_int_max": { "type": "integer", "minimum": 1, "default": 30 }
          }
        }
      }
    }
  }
}
