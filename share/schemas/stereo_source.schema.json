{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dvrk_data:stereo_source@1.0.0",
  "title": "dVRK stereo source configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "camera"],
  "properties": {
    "type": { "const": "dvrk_data:stereo_source@1.0.0" },
    "name": { "type": "string", "minLength": 1, "default": "dvrk_display" },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right"],
      "properties": {
        "size": { "$ref": "#/$defs/size" },
        "left": { "$ref": "#/$defs/sourceEndpoint" },
        "right": { "$ref": "#/$defs/sourceEndpoint" }
      }
    }
  },
  "$defs": {
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "sourceEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gst_input"],
      "properties": {
        "gst_input": { "$ref": "#/$defs/gstInput" },
        "gst_output": { "$ref": "#/$defs/gstOutput" }
      }
    },
    "gstInput": {
      "type": "string",
      "minLength": 1,
      "description": "Plain GStreamer pipeline or canonical @dvrk:role:name socket reference."
    },
    "gstOutput": {
      "type": "string",
      "anyOf": [
        { "const": "" },
        { "pattern": "^@dvrk:[^:]+:[^:]+$" }
      ],
      "description": "Canonical dVRK abstract socket reference."
    }
  }
}
